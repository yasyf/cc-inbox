{
  "name": "cc-inbox",
  "description": "Local, typed, append-only inbox CLI (cci) and Claude Code plugin for multi-agent drive coordination with bounded reads",
  "version": "0.54.38",
  "author": {
    "name": "Yasyf Mohamedali",
    "email": "yasyf@poetic.com"
  },
  "homepage": "https://github.com/yasyf/cc-inbox",
  "mcpServers": {
    "cci": {
      "command": "cci",
      "args": [
        "mcp"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": ""
      },
      "alwaysLoad": true
    },
    "channel": {
      "command": "cci",
      "args": [
        "channel",
        "--no-tools"
      ],
      "env": {
        "CLAUDE_PLUGIN_ROOT": ""
      },
      "alwaysLoad": true
    }
  },
  "channels": [
    {
      "server": "channel",
      "displayName": "cci"
    }
  ]
}
