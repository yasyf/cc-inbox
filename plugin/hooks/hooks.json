{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cci\" hook session-start", "timeout": 15 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cci\" hook announce", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:7377/v1/hook/post-tool-use", "headers": { "X-Cci-Hook": "1", "X-Cci-Home": "$CCI_HOME" }, "allowedEnvVars": ["CCI_HOME"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:7377/v1/hook/post-tool-use", "headers": { "X-Cci-Hook": "1", "X-Cci-Home": "$CCI_HOME" }, "allowedEnvVars": ["CCI_HOME"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:7377/v1/hook/stop", "headers": { "X-Cci-Hook": "1", "X-Cci-Home": "$CCI_HOME" }, "allowedEnvVars": ["CCI_HOME"], "timeout": 10 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cci\" hook stop-failure", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:7377/v1/hook/subagent-stop", "headers": { "X-Cci-Hook": "1", "X-Cci-Home": "$CCI_HOME" }, "allowedEnvVars": ["CCI_HOME"], "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cci\" hook prompt", "timeout": 10 }
        ]
      }
    ]
  }
}
