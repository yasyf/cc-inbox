+	"encoding/json"
@@ -12,0 +14,44 @@
+
+type indexMaintenanceProfile struct {
+	Label             string `json:"label"`
+	Phase             string `json:"phase"`
+	Object            string `json:"object"`
+	AtNS              int64  `json:"at_ns"`
+	ElapsedNS         int64  `json:"elapsed_ns"`
+	RowsAffected      *int64 `json:"rows_affected,omitempty"`
+	RowsAffectedError string `json:"rows_affected_error,omitempty"`
+	Value             *int64 `json:"value,omitempty"`
+	Installed         *bool  `json:"installed,omitempty"`
+}
+
+func emitIndexMaintenanceProfile(sample indexMaintenanceProfile) {
+	if os.Getenv("CCI_INDEX_PROFILE_SCOPE") != "selected-250k" {
+		return
+	}
+	sample.Label = os.Getenv("CCI_INDEX_PROFILE_LABEL")
+	sample.AtNS = time.Now().UnixNano()
+	encoded, err := json.Marshal(sample)
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("CCI_INDEX_PROFILE %s\n", encoded)
+}
+
+func indexMaintenanceProfileSince(phase, object string, started time.Time) {
+	emitIndexMaintenanceProfile(indexMaintenanceProfile{Phase: phase, Object: object, ElapsedNS: time.Since(started).Nanoseconds()})
+}
+
+func indexMaintenanceProfileValue(phase, object string, started time.Time, value int64) {
+	emitIndexMaintenanceProfile(indexMaintenanceProfile{Phase: phase, Object: object, ElapsedNS: time.Since(started).Nanoseconds(), Value: &value})
+}
+
+func indexMaintenanceProfileResult(object string, started time.Time, result sql.Result) {
+	sample := indexMaintenanceProfile{Phase: "Populate", Object: object, ElapsedNS: time.Since(started).Nanoseconds()}
+	rows, err := result.RowsAffected()
+	if err != nil {
+		sample.RowsAffectedError = err.Error()
+	} else {
+		sample.RowsAffected = &rows
+	}
+	emitIndexMaintenanceProfile(sample)
+}
